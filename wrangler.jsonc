{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ozturkbatu-web",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "ozturkbatu.com", "custom_domain": true },
    { "pattern": "www.ozturkbatu.com", "custom_domain": true }
  ]
}
