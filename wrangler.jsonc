{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ozturkbatu-web",
  "compatibility_date": "2026-08-09",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CONTRIBUTIONS", "id": "751bfab3071c4edd855f0391787a6882" }
  ],
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "ozturkbatu.com", "custom_domain": true },
    { "pattern": "www.ozturkbatu.com", "custom_domain": true }
  ]
}
