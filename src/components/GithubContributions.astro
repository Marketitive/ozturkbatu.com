---
import data from '../data/github-contributions.json';
const updated = new Date(data.generatedAt).toISOString().slice(0, 10);
---

<section class="gh" id="gh-contrib">
  <div class="gh-head">
    <h2>GitHub activity</h2>
    <span><span id="gh-total">{data.total}</span> contributions in the last year</span>
  </div>
  <div id="gh-grid" class="gh-grid" style={`grid-template-columns: repeat(${data.weeks.length}, minmax(0, 1fr));`}>
    {data.weeks.flatMap((week) => week).map((day) => (
      <div class={`gh-cell l${day.level}`} title={`${day.date}: ${day.count}`}></div>
    ))}
  </div>
  <p class="gh-note">Includes work in private repositories (counts only). Updated <span id="gh-updated">{updated}</span>.</p>
</section>

<script is:inline>
  (function () {
    fetch('/api/contributions')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.weeks) return;
        var grid = document.getElementById('gh-grid');
        grid.style.gridTemplateColumns = 'repeat(' + d.weeks.length + ', minmax(0, 1fr))';
        grid.innerHTML = '';
        d.weeks.forEach(function (week) {
          week.forEach(function (day) {
            var el = document.createElement('div');
            el.className = 'gh-cell l' + day.level;
            el.title = day.date + ': ' + day.count;
            grid.appendChild(el);
          });
        });
        document.getElementById('gh-total').textContent = d.total;
        document.getElementById('gh-updated').textContent = String(d.generatedAt).slice(0, 10);
      })
      .catch(function () {});
  })();
</script>
