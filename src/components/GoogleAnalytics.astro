---
// Google Analytics 4, loaded only after the visitor consents (TDDDG § 25 / GDPR Art. 6(1)(a)).
// Measurement ID: G-Q4RFHET6C9
---

<script is:inline>
  (function () {
    var GA_ID = 'G-Q4RFHET6C9';
    var KEY = 'analytics-consent';

    function read() {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    }
    function write(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
    }

    function loadGA() {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID, { anonymize_ip: true, cookie_flags: 'SameSite=None;Secure' });
    }

    function showBanner() {
      var bar = document.createElement('div');
      bar.setAttribute('role', 'dialog');
      bar.setAttribute('aria-label', 'Analytics consent');
      bar.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:100;padding:12px 16px;background:#111;color:#ddd;border-top:1px solid #333;font:14px/1.4 system-ui,sans-serif;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between';
      bar.innerHTML =
        '<span style="flex:1 1 260px">This site uses Google Analytics to understand usage, only if you agree. See the <a href="/datenschutz" style="color:#fff;text-decoration:underline">privacy policy</a>.</span>' +
        '<span style="display:flex;gap:8px">' +
        '<button id="ga-decline" style="padding:8px 14px;border:1px solid #555;background:transparent;color:#ddd;border-radius:6px;cursor:pointer">Decline</button>' +
        '<button id="ga-accept" style="padding:8px 14px;border:0;background:#fff;color:#000;border-radius:6px;cursor:pointer;font-weight:600">Accept</button>' +
        '</span>';
      document.body.appendChild(bar);
      document.getElementById('ga-accept').onclick = function () { write('granted'); bar.remove(); loadGA(); };
      document.getElementById('ga-decline').onclick = function () { write('denied'); bar.remove(); };
    }

    // Lets the privacy page withdraw or change consent.
    window.resetAnalyticsConsent = function () {
      try { localStorage.removeItem(KEY); } catch (e) {}
      location.reload();
    };

    var state = read();
    if (state === 'granted') loadGA();
    else if (state !== 'denied') document.addEventListener('DOMContentLoaded', showBanner);
  })();
</script>
