---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You! - Batuhan Öztürk" description="Successfully subscribed to newsletter">
  <div class="max-w-2xl mx-auto text-center py-20">
    <div class="mb-8">
      <svg class="w-24 h-24 text-accent mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
    
    <h1 class="text-4xl font-bold text-foreground mb-4">🎉 Thank You for Subscribing!</h1>
    
    <p class="text-xl text-muted-foreground mb-8">
      You'll receive the latest insights on competitive marketing, automation & AI delivered to your inbox.
    </p>
    
    <div class="bg-card/50 backdrop-blur-sm rounded-lg p-6 mb-8 max-w-md mx-auto">
      <p class="text-muted-foreground mb-2">
        ✓ Subscription confirmed
      </p>
      <p class="text-muted-foreground">
        ✓ You can unsubscribe at any time
      </p>
    </div>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a 
        href="/" 
        class="inline-flex items-center justify-center px-6 py-3 bg-accent text-white font-semibold rounded-lg hover:bg-accent/90 transition-all hover:scale-105"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        Back to Home
      </a>
      
      <a 
        href="/blog" 
        class="inline-flex items-center justify-center px-6 py-3 bg-card text-foreground font-semibold rounded-lg hover:bg-card/80 transition-all hover:scale-105 border border-border"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        Read Articles
      </a>
    </div>
  </div>
</BaseLayout>

