---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Downloads - Batuhan Ozturk" description="Download resources, templates, and content processing system documentation">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-bold text-foreground mb-8">Downloads</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Content Processing System Documentation -->
      <div class="bg-card rounded-lg p-6 shadow-lg hover:shadow-xl transition-all">
        <div class="flex items-center mb-4">
          <svg class="w-8 h-8 text-accent mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h2 class="text-xl font-bold text-foreground">Content Processing System</h2>
        </div>
        <p class="text-muted-foreground mb-4">
          Complete documentation and flowchart of the multi-module content processing and management system.
        </p>
        <div class="space-y-2">
          <a href="/Screenshot 2025-10-13 at 22.47.10.png" download class="block w-full text-center bg-accent text-white px-4 py-2 rounded-lg hover:bg-accent/90 transition-colors">
            Download Flowchart (PNG)
          </a>
        </div>
      </div>

      <!-- Marketing Templates -->
      <div class="bg-card rounded-lg p-6 shadow-lg hover:shadow-xl transition-all">
        <div class="flex items-center mb-4">
          <svg class="w-8 h-8 text-accent mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
          </svg>
          <h2 class="text-xl font-bold text-foreground">Marketing Templates</h2>
        </div>
        <p class="text-muted-foreground mb-4">
          Ready-to-use templates for social media content, email campaigns, and marketing automation.
        </p>
        <div class="space-y-2">
          <a href="#" class="block w-full text-center bg-muted text-foreground px-4 py-2 rounded-lg opacity-50 cursor-not-allowed">
            Coming Soon
          </a>
        </div>
      </div>

      <!-- Automation Scripts -->
      <div class="bg-card rounded-lg p-6 shadow-lg hover:shadow-xl transition-all">
        <div class="flex items-center mb-4">
          <svg class="w-8 h-8 text-accent mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <h2 class="text-xl font-bold text-foreground">Automation Scripts</h2>
        </div>
        <p class="text-muted-foreground mb-4">
          Python scripts and automation tools for content processing, data analysis, and workflow optimization.
        </p>
        <div class="space-y-2">
          <a href="#" class="block w-full text-center bg-muted text-foreground px-4 py-2 rounded-lg opacity-50 cursor-not-allowed">
            Coming Soon
          </a>
        </div>
      </div>

      <!-- Performance Reports -->
      <div class="bg-card rounded-lg p-6 shadow-lg hover:shadow-xl transition-all">
        <div class="flex items-center mb-4">
          <svg class="w-8 h-8 text-accent mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <h2 class="text-xl font-bold text-foreground">Performance Reports</h2>
        </div>
        <p class="text-muted-foreground mb-4">
          Weekly performance analysis reports and insights from content distribution channels.
        </p>
        <div class="space-y-2">
          <a href="#" class="block w-full text-center bg-muted text-foreground px-4 py-2 rounded-lg opacity-50 cursor-not-allowed">
            Coming Soon
          </a>
        </div>
      </div>

      <!-- AI Content Templates -->
      <div class="bg-card rounded-lg p-6 shadow-lg hover:shadow-xl transition-all">
        <div class="flex items-center mb-4">
          <svg class="w-8 h-8 text-accent mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          <h2 class="text-xl font-bold text-foreground">AI Content Templates</h2>
        </div>
        <p class="text-muted-foreground mb-4">
          Pre-configured AI prompts and templates for content generation across different platforms.
        </p>
        <div class="space-y-2">
          <a href="#" class="block w-full text-center bg-muted text-foreground px-4 py-2 rounded-lg opacity-50 cursor-not-allowed">
            Coming Soon
          </a>
        </div>
      </div>

      <!-- Business Process Documentation -->
      <div class="bg-card rounded-lg p-6 shadow-lg hover:shadow-xl transition-all">
        <div class="flex items-center mb-4">
          <svg class="w-8 h-8 text-accent mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <h2 class="text-xl font-bold text-foreground">Business Process Docs</h2>
        </div>
        <p class="text-muted-foreground mb-4">
          Comprehensive documentation of business processes, automation workflows, and operational procedures.
        </p>
        <div class="space-y-2">
          <a href="#" class="block w-full text-center bg-muted text-foreground px-4 py-2 rounded-lg opacity-50 cursor-not-allowed">
            Coming Soon
          </a>
        </div>
      </div>
    </div>

    <!-- System Overview Section -->
    <div class="mt-12 bg-card rounded-lg p-8">
      <h2 class="text-2xl font-bold text-foreground mb-6">Content Processing System Overview</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <p class="text-muted-foreground mb-4">
            The content processing system is a comprehensive multi-module platform that handles everything from data ingestion 
            to content repurposing. It features intelligent relevancy scoring, semantic similarity matching, and automated 
            content distribution across multiple channels.
          </p>
          <ul class="space-y-2 text-muted-foreground">
            <li class="flex items-center">
              <svg class="w-4 h-4 text-accent mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Data ingestion from multiple sources (X, LinkedIn, YouTube, Web, Notes)
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 text-accent mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Intelligent relevancy scoring and content filtering
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 text-accent mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Semantic similarity matching and pillar assignment
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 text-accent mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              AI-powered content generation and distribution
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 text-accent mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Performance analysis and content repurposing
            </li>
          </ul>
        </div>
        <div class="text-center">
          <img 
            src="/Screenshot 2025-10-13 at 22.47.10.png" 
            alt="Content Processing System Flowchart"
            class="rounded-lg shadow-lg mx-auto max-w-full h-auto"
          />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
