---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'GalleryMVP',
    images: [] as { src: string; alt: string }[], // screenshots in /public/projects/<slug>/
    github: '' as string, // set to turn the title into a link
    tagline: 'A walkable 3D gallery that proves attribution, not just aesthetics',
    description:
      "A browser-based 3D exhibition space built to test a real question: can a single shared, walkable gallery actually drive attributable traffic to individual artists' own portfolios — without renting an existing SaaS gallery platform and without a game engine? Built with Next.js and React Three Fiber, it pairs a navigable 3D room (click-to-move, drag-to-look, focus-zoom on artwork, a draggable bottom sheet for artist stories) with a server-side attribution layer: every \"View Portfolio\" click routes through a server-controlled redirect that logs the click, filters out bots and crawlers, and dedupes repeat visits — all before handing the visitor off to the artist's real site. Content is managed through a headless CMS, with funnel analytics tracking exactly where visitor interest drops off between entering the room and clicking through.",
    stack: ['Next.js', 'React Three Fiber', 'Three.js', 'TypeScript', 'SQLite', 'headless CMS', 'product analytics'],
  },
  {
    title: 'MarketingLab',
    images: [] as { src: string; alt: string }[],
    github: '' as string,
    tagline: 'A/B test content against a simulated audience before it ever goes live',
    description:
      "Instead of spending real followers to learn whether a headline lands, MarketingLab simulates the test first. Users define an audience profile and write content variants; the platform spins up hundreds of independent AI agents, each with its own interest profile and social connections, and lets them decide — individually, using a real language model — whether to view, engage, or ignore each variant. Agent participation is staged across rounds that mimic a real post's lifecycle: slow start, viral peak, gradual fade. A live feed streams the simulation as it runs, and a results dashboard rolls everything into a single composite score per variant, so the winning version of a piece of content is a data point, not a guess.",
    stack: ['Next.js', 'FastAPI', 'Python', 'OpenAI', 'WebSocket', 'SQLite'],
  },
  {
    title: 'Divit',
    images: [] as { src: string; alt: string }[],
    github: '' as string,
    tagline: "An AI writing coach that asks what you're trying to do before it tells you how to write it",
    description:
      "Most AI writing tools give generic line edits. Divit starts differently: before you write a word, it asks what the piece needs to do — explain a concept, convince a skeptic, close a sale, connect emotionally. That stated goal becomes the filter every piece of AI feedback runs through, grounded in storytelling frameworks matched to the goal rather than generic style polish. The interface keeps writing, AI feedback, and document management in one three-panel workspace, with real-time inline grammar correction, the ability to lock individual paragraphs out of AI review (useful for approved legal language or finished sections), and export to Markdown or PDF. Everything is stored locally in the browser — no backend database, no server-side data retention.",
    stack: ['React', 'Vite', 'TipTap', 'FastAPI', 'LangChain', 'Gemini', 'OpenAI', 'Docker'],
  },
  {
    title: 'DeepLocate',
    images: [] as { src: string; alt: string }[],
    github: '' as string,
    tagline: 'Exhaustive local business data, past the 20-result wall every mapping API hits',
    description:
      "Every mapping API caps a single search at 20 results, which means any serious market research or competitive mapping of a real city district comes back silently incomplete. DeepLocate fixes this with quad-tree decomposition: it recursively splits a geographic area into smaller cells, queries each one, and keeps subdividing any cell that's still hitting the cap — until every business in the region has been captured exactly once. It runs as a CLI for scripted batch jobs or as a live web interface that visualizes the subdivision in real time, color-coding each cell by business density as results stream in. Output is deduplicated and exported to CSV or JSON, ready for lead generation or competitive analysis.",
    stack: ['Python', 'FastAPI', 'Google Places API', 'Leaflet.js', 'WebSocket', 'Pandas'],
  },
  {
    title: 'Perfin',
    images: [] as { src: string; alt: string }[],
    github: '' as string,
    tagline: "Personal finance intelligence that never sends your bank data to the cloud",
    description:
      "Perfin is built on a simple premise: financial categorization and forecasting don't need a cloud LLM, and your bank statements shouldn't have to leave your machine to get useful insight. It ingests raw CSV exports, normalizes them into a relational database, and runs a fully offline machine-learning pipeline — a local classifier for transaction categorization, fuzzy matching to unify fractured merchant names, recurring-bill detection, statistical anomaly flagging, and cash-flow forecasting via regression. Access is through a lightweight REST API or a 20+ command CLI, proving that compact, local code can do the job of a heavier cloud-dependent tool without the privacy trade-off.",
    stack: ['Python', 'scikit-learn', 'SQLAlchemy', 'SQLite', 'Flask', 'Click', 'Pandas', 'Plotly'],
  },
];
---

<BaseLayout
  title="Projects - Batuhan Ozturk"
  description="A working portfolio of things I've built — each one a bet on a specific idea, tested end-to-end rather than left as a mockup."
>
  <div class="max-w-4xl mx-auto px-6 py-12">
    <header class="text-center mb-12">
      <h1 class="text-3xl font-bold text-foreground mb-3">Projects</h1>
      <p class="text-muted-foreground max-w-2xl mx-auto">
        A working portfolio of things I've built — each one a bet on a specific idea, tested end-to-end rather than left as a mockup.
      </p>
    </header>

    <div class="space-y-6">
      {projects.map((project) => (
        <article class="bg-card rounded-lg p-6 md:p-8">
          <h2 class="text-xl font-bold text-foreground mb-1">
            {project.github ? (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{project.title} ↗</a>
            ) : project.title}
          </h2>
          <p class="text-accent font-medium mb-4">{project.tagline}</p>
          <p class="text-muted-foreground leading-relaxed mb-5">{project.description}</p>
          {project.images && project.images.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
              {project.images.map((img) => (
                <img src={img.src} alt={img.alt} loading="lazy" class="rounded-md w-full" />
              ))}
            </div>
          )}
          <div class="flex flex-wrap gap-2">
            {project.stack.map((tech) => (
              <span class="text-xs px-2.5 py-1 rounded-full bg-secondary text-secondary-foreground">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
