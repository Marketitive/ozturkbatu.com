---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Get all unique tags from posts
const allTags = [...new Set(sortedPosts.flatMap(post => post.data.tags || []))].sort();

// Group posts by year and month
const postsByYearMonth = sortedPosts.reduce((acc, post) => {
  const date = new Date(post.data.pubDate);
  const year = date.getFullYear();
  const month = date.getMonth();
  
  if (!acc[year]) {
    acc[year] = {};
  }
  if (!acc[year][month]) {
    acc[year][month] = [];
  }
  acc[year][month].push(post);
  return acc;
}, {} as Record<number, Record<number, typeof sortedPosts>>);

const years = Object.keys(postsByYearMonth).sort((a, b) => Number(b) - Number(a));
const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
---

<BaseLayout title="Articles - Batuhan Ozturk" description="Thoughts, tests, and insights about competitive marketing, ai-driven business and automation">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <!-- Header -->
    <header class="mb-12">
      <h1 class="text-6xl font-bold mb-2">Index</h1>
    </header>

    <!-- Category Filter Buttons -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2">
        <button 
          id="filter-all" 
          class="filter-btn active px-4 py-2 rounded-full text-sm font-medium bg-accent text-white border border-accent hover:bg-accent/90 transition-colors"
          data-filter="all"
        >
          All
        </button>
        {allTags.map((tag) => (
          <button 
            class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-background text-foreground hover:bg-accent hover:text-white hover:border hover:border-accent transition-colors"
            data-filter={tag}
          >
            {tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Articles organized by year and month -->
    <div class="space-y-8">
      {years.map((year) => {
        const yearData = postsByYearMonth[Number(year)];
        const months = Object.keys(yearData).sort((a, b) => Number(b) - Number(a));
        
        return (
          <div class="space-y-6">
            {months.map((month) => {
              const monthPosts = yearData[Number(month)];
              const monthName = monthNames[Number(month)];
              
              return (
                <section class="space-y-4">
                  <h2 class="text-xl font-medium text-foreground">
                    {year} {monthName}
                  </h2>
                  <div class="space-y-3">
                    {monthPosts.map((post) => {
                      const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      });
                      
                      return (
                        <article 
                          class="blog-post" 
                          data-tags={post.data.tags ? post.data.tags.join(',') : ''}
                        >
                          <a href={`/blog/${post.slug}`} class="block group">
                            <div class="text-sm text-muted-foreground flex items-center">
                              <span>{formattedDate}</span>
                              <span class="flex-1 border-b border-dotted border-muted-foreground/30 mx-3"></span>
                              <span class="font-bold text-foreground group-hover:text-accent transition-colors">
                                {post.data.title}
                              </span>
                            </div>
                          </a>
                        </article>
                      );
                    })}
                  </div>
                </section>
              );
            })}
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  // Blog Filter Functionality with Multi-Select
  document.addEventListener('DOMContentLoaded', function() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const blogPosts = document.querySelectorAll('.blog-post');
    const sections = document.querySelectorAll('section');
    let selectedFilters = new Set(['all']); // Track selected filters
    
    function updateButtonStates() {
      filterButtons.forEach(btn => {
        const filter = btn.getAttribute('data-filter');
        const isSelected = selectedFilters.has(filter);
        
        if (isSelected) {
          btn.classList.add('active', 'bg-accent', 'text-white', 'border', 'border-accent');
          btn.classList.remove('bg-background', 'text-foreground');
        } else {
          btn.classList.remove('active', 'bg-accent', 'text-white', 'border', 'border-accent');
          btn.classList.add('bg-background', 'text-foreground');
        }
      });
    }
    
    function filterPosts() {
      blogPosts.forEach(post => {
        const postTags = post.getAttribute('data-tags').split(',').filter(tag => tag.trim() !== '');
        
        // If "all" is selected, show all posts
        if (selectedFilters.has('all')) {
          post.style.display = 'block';
        } else {
          // Check if post has any of the selected tags
          const hasSelectedTag = postTags.some(tag => selectedFilters.has(tag));
          post.style.display = hasSelectedTag ? 'block' : 'none';
        }
      });
      
      // Hide/show sections based on visible posts
      sections.forEach(section => {
        const visiblePosts = section.querySelectorAll('.blog-post[style="display: block;"], .blog-post:not([style*="display: none"])');
        if (visiblePosts.length === 0) {
          section.style.display = 'none';
        } else {
          section.style.display = 'block';
        }
      });
    }
    
    filterButtons.forEach(button => {
      button.addEventListener('click', function() {
        const filter = this.getAttribute('data-filter');
        
        if (filter === 'all') {
          // If "all" is clicked, clear other selections and select only "all"
          selectedFilters.clear();
          selectedFilters.add('all');
        } else {
          // Toggle the filter
          if (selectedFilters.has(filter)) {
            selectedFilters.delete(filter);
          } else {
            selectedFilters.add(filter);
            // Remove "all" if a specific filter is selected
            selectedFilters.delete('all');
          }
          
          // If no specific filters are selected, automatically select "all"
          if (selectedFilters.size === 0) {
            selectedFilters.add('all');
          }
        }
        
        updateButtonStates();
        filterPosts();
      });
    });
  });
</script>
