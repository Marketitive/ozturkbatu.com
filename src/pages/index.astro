---
import StoryLayout from '../layouts/StoryLayout.astro';
import GithubContributions from '../components/GithubContributions.astro';

// About copy. Markup: {hl:text} highlight, {ul:text} underline, {ci:text} circle,
// {x:wrong|right} strike the wrong word and write the correction.
const about = [
  "Most AI investment goes into the visible layer: models, tools, frameworks. But what decides whether AI pays off is the {x:tool stack|foundation} underneath it: the systems that collect, structure and move data across a business.",
  "Without them, AI output stays inconsistent, and its {hl:value disappears when the session ends}. I design and build those systems: data architecture, pipelines and AI agents that connect {ul:marketing, sales and customer success}, so results last, can be audited and keep {ci:compounding}.",
  "In practice, that means one reliable record of every lead, customer and deal, pipelines that check facts before they reach a decision, and agents that work with the team's data instead of overwriting it. When the system is right, every campaign, deal and customer conversation makes the next one {ci:smarter}.",
  "I came to this by {x:studying|building}. My first system, for a business I {hl:co-founded}, contacted new leads the moment they reached the CRM.",
  "Later, I replaced manual outreach spreadsheets with enriched people databases and brought marketing data from every channel across a group of companies into one view. That work took me from a junior marketing role to {hl:leading AI and automation}.",
  "Today I build and maintain a {ul:multi-agent system} for a venture fund that turns pitch decks into investment analyses partners can act on, checking its own facts along the way.",
  "My own foundation was built on the court. I played professional volleyball in Türkiye and won {hl:three national championships}. Volleyball is a game of systems: rotations, set plays, and reading the opponent's patterns before the serve.",
  "Talent wins points. {x:Talent|Structure} wins seasons. When injuries ended my career, I moved to Germany in 2015 and started over with a new language and a new field, {ul:teaching myself} the skills I use today.",
  "I still see business the way I saw a match. Every market is a {ci:competition}, and there is no neutral side of the net.",
  "Companies that build systems to turn their data into decisions, and run them with AI, will {x:keep up with|outplay} the ones that don't. You either build that advantage, or you compete against someone who has.",
];

const heroLines = [
  "AI is only as good as the {x:model|data} underneath it.",
  "I build the systems that turn it into {ci:revenue}.",
];

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const ann = (s: string) =>
  esc(s).replace(/\{(hl|ul|ci|x):([^}]+)\}/g, (_m, kind, body) => {
    if (kind === 'x') {
      const [wrong, right] = body.split('|');
      return `<span class="ann" data-ann="x"><del>${wrong}</del></span><ins class="fix">${right}</ins>`;
    }
    return `<span class="ann" data-ann="${kind}">${body}</span>`;
  });
const paragraphs = about.map(ann);
const heroHtml = heroLines.map(ann);

const projects = [
  {
    img: 'medzeka.jpg', title: 'Medzeka', rot: 3,
    left: "An agentic layer on top of a private clinic's data. It aggregates appointments, revenue and performance, pseudonymizes everything for GDPR, then analyzes it with ML and AI.",
    right: "It predicts no-shows, revenue, performance and appointment calendars, and every week writes a C-level report that lands with the founders and owners.",
    stack: ['Python', 'Deep Agents', 'Postgres', 'Qdrant'],
  },
  {
    img: '20horizon.jpg', title: '20Horizon', rot: -4,
    left: "Artists struggle with visibility, and posting more content or hosting a personal gallery only works as well as their own marketing skills. 20Horizon takes that job off their hands.",
    right: "Twenty artworks from twenty artists share one gallery for 60 days, with professional marketing behind all of them. Traffic comes into the gallery first, then each artist's profile sends buyers on to their own site.",
    stack: ['Next.js', 'React Three Fiber', 'TypeScript', 'SQLite'],
  },
  {
    img: 'marketinglab.jpg', title: 'MarketingLab', rot: 3,
    left: "A synthetic population built from a brand's ideal customer profiles, so content can be tested before it costs real money in a real campaign.",
    right: "Hundreds of AI agents react to each content variant, deciding to view, engage or ignore. The best performer is found without running A/B tests on live audiences.",
    stack: ['Next.js', 'FastAPI', 'OpenAI', 'WebSocket'],
  },
  {
    img: 'divit.jpg', title: 'Divit', rot: -2,
    left: "Divit frees writers from the blank page. An agent that knows multiple storytelling frameworks turns the writer's goal into an end-to-end narrative strategy.",
    right: "The chosen narrative shapes every tip and hint along the way, so the author finishes the work with an AI co-writer in less time.",
    stack: ['React', 'TipTap', 'FastAPI', 'LangChain'],
  },
  {
    img: 'deeplocate.jpg', title: 'DeepLocate', rot: 4,
    left: "Local business data is hard to get. Most databases barely cover it, which leaves Google Maps as the only source, and its limits make automated collection painful.",
    right: "DeepLocate takes the coordinates of a city or district and scans the whole area. It starts with one large rectangle and keeps splitting any zone with too many results, until every cell is under the threshold.",
    stack: ['Python', 'FastAPI', 'Leaflet', 'Pandas'],
  },
  {
    img: 'perfin.jpg', title: 'Perfin', rot: -3,
    left: "A personal finance agent I run locally. It reads monthly invoices and bank statements, recognizes the issuing bank and its statement format, and extracts the data.",
    right: "Statements are anonymized before an ML model analyzes them. The result is a budget that updates itself, income and expense forecasts, and a nudge toward financial discipline.",
    stack: ['Python', 'scikit-learn', 'SQLAlchemy', 'Flask'],
  },
];
---

<StoryLayout>
  <div id="preloader" aria-hidden="true"><img src="/signature.png" alt="" /></div>
  <noscript><style>#preloader{display:none}</style></noscript>

  <header class="site-header">
    <a href="#top" aria-label="Back to top"><img class="sig" src="/signature.png" alt="Batuhan Öztürk" /></a>
    <nav>
      <a href="#about">About</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
      <button id="theme-toggle" type="button" aria-label="Toggle light and dark mode">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
      </button>
    </nav>
  </header>

  <main id="top">
    <!-- HERO SLOT: the 3D bust goes between the greeting and the role in Phase 2 -->
    <section class="hero">
      <div class="hero-grid">
        <h1>Hi, I'm Batu.</h1>
        <p class="role">AI &amp; RevOps Architect.</p>
        <div class="hero-lines">
          {heroHtml.map((html) => <p class="hero-line" set:html={html} />)}
        </div>
      </div>
      <span class="scroll-hint">Scroll</span>
    </section>

    <section class="about" id="about">
      <div class="about-stage">
        {paragraphs.map((html) => <p class="para" set:html={html} />)}
      </div>
    </section>

    <section class="projects" id="projects">
      <div class="wrap">
        <h2 class="section-title">Selected projects</h2>
        <div class="stage" id="stage">
          {projects.map((p) => (
            <article class="project">
              <div class="txt-l">
                <h3>{p.title}</h3>
                <p>{p.left}</p>
              </div>
              <figure class="polaroid" style={`--rot:${p.rot}deg`}>
                <img src={`/projects/${p.img}`} alt={`${p.title} screenshot`} loading="lazy" />
                <figcaption>{p.title}</figcaption>
              </figure>
              <div class="txt-r">
                <p>{p.right}</p>
                <div class="stack">{p.stack.map((t) => <span>{t}</span>)}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="wrap">
        <div class="contact-grid">
          <div class="contact-img"><img src="/profile.jpeg" alt="Batuhan Öztürk surfing in a suit" loading="lazy" /></div>
          <div>
            <h2 class="section-title">Let's talk.</h2>
            <a class="mail" href="mailto:ozturkbatu@gmail.com">ozturkbatu@gmail.com</a>
            <div class="links">
              <a href="https://www.linkedin.com/in/ozturkbatu/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
              <a href="https://x.com/ozturkbatu_" target="_blank" rel="noopener noreferrer">X ↗</a>
              <a href="https://github.com/ozturkbatu" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </div>
            <a class="cv-btn" href="/cv.pdf" download>Download CV ↓</a>
            <GithubContributions />
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <img class="big-sig" src="/signature.png" alt="" loading="lazy" />
    <div class="legal">
      <a href="/impressum">Imprint</a>
      <a href="/datenschutz">Privacy</a>
      <span>&copy; {new Date().getFullYear()}</span>
    </div>
  </footer>

  <script>
    import '../scripts/story.js';
  </script>
</StoryLayout>
