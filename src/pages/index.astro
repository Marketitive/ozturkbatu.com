---
import StoryLayout from '../layouts/StoryLayout.astro';
import GithubContributions from '../components/GithubContributions.astro';

// About copy. Markup: {hl:text} highlight, {ul:text} underline, {ci:text} circle,
// {x:wrong|right} strike the wrong word and write the correction.
const about = [
  "I'm Batu. I build the {ul:data infrastructure} that lets AI results {hl:compound} instead of evaporating after a demo.",
  "Most AI investment goes into models, tools and frameworks, the visible layer. The bottleneck is {x:the model|the data}. Without a structured foundation, AI output is inconsistent, and value disappears when a session ends instead of compounding.",
  "Closing that gap is the actual work: data architecture and pipelines that connect business systems to AI in a durable, {ul:auditable} way, so results persist and scale.",
  "At {hl:AI.GROUP} I work on automation and AI initiatives across the group's portfolio companies, from early diagnostics to production systems. One example is an autonomous deal-flow pipeline for {hl:AI.FUND} that ingests pitch decks, researches the companies and drafts investment notes without manual handoffs.",
  "Before this I played competitive volleyball, {ci:three-time national champion}. That built the discipline I bring to systems: repeatable, tested under pressure, not left to chance.",
  "My Master's in Sport and Movement Science, with a thesis on athlete self-presentation, taught me the other half. Structured data collection usually breaks for {x:technical|human and organizational} reasons first.",
  "This site is where I document that view.",
];

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const ann = (s: string) =>
  esc(s).replace(/\{(hl|ul|ci|x):([^}]+)\}/g, (_m, kind, body) => {
    if (kind === 'x') {
      const [wrong, right] = body.split('|');
      return `<span class="ann" data-ann="x"><del>${wrong}</del></span><ins class="fix">${right}</ins>`;
    }
    return `<span class="ann" data-ann="${kind}">${body}</span>`;
  });
const paragraphs = about.map(ann);

const projects = [
  {
    slug: 'gallerymvp', title: '20Horizon', rot: -4,
    left: "A walkable 3D gallery that proves attribution, not just aesthetics. Built to test whether one shared gallery can drive attributable traffic to individual artists' portfolios, without a SaaS platform or a game engine.",
    right: "A Next.js and React Three Fiber room with click-to-move and focus-zoom. Every portfolio click routes through a server redirect that logs it, filters bots and dedupes repeat visits.",
    stack: ['Next.js', 'React Three Fiber', 'TypeScript', 'SQLite'],
  },
  {
    slug: 'marketinglab', title: 'MarketingLab', rot: 3,
    left: "A/B test content against a simulated audience before it ever goes live, instead of spending real followers to find out.",
    right: "Hundreds of independent AI agents, each with its own interests and connections, decide whether to view, engage or ignore each variant across staged rounds. Results roll up into one composite score per variant.",
    stack: ['Next.js', 'FastAPI', 'OpenAI', 'WebSocket'],
  },
  {
    slug: 'divit', title: 'Divit', rot: -2,
    left: "An AI writing coach that asks what you are trying to do before it tells you how to write it.",
    right: "The stated goal becomes the filter for all feedback, grounded in storytelling frameworks. Paragraphs can be locked out of AI review, and everything stays local in the browser.",
    stack: ['React', 'TipTap', 'FastAPI', 'LangChain'],
  },
  {
    slug: 'deeplocate', title: 'DeepLocate', rot: 4,
    left: "Exhaustive local business data, past the 20-result wall every mapping API hits.",
    right: "Quad-tree decomposition recursively splits an area until every cell is under the cap, so each business is captured exactly once. Runs as a CLI or a live map that visualizes the subdivision.",
    stack: ['Python', 'FastAPI', 'Leaflet', 'Pandas'],
  },
  {
    slug: 'perfin', title: 'Perfin', rot: -3,
    left: "Personal finance intelligence that never sends your bank data to the cloud.",
    right: "A fully offline ML pipeline: transaction categorization, fuzzy merchant matching, recurring-bill detection, anomaly flags and cash-flow forecasting, through a REST API or a 20+ command CLI.",
    stack: ['Python', 'scikit-learn', 'SQLAlchemy', 'Flask'],
  },
];
---

<StoryLayout>
  <div id="preloader" aria-hidden="true"><img src="/signature.png" alt="" /></div>
  <noscript><style>#preloader{display:none}</style></noscript>

  <header class="site-header">
    <a href="#top" aria-label="Back to top"><img class="sig" src="/signature.png" alt="Batuhan Öztürk" /></a>
    <nav>
      <a href="#about" class="hide-sm">About</a>
      <a href="#projects" class="hide-sm">Projects</a>
      <a href="#contact">Contact</a>
      <button id="theme-toggle" type="button" aria-label="Toggle light and dark mode">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
      </button>
    </nav>
  </header>

  <main id="top">
    <!-- HERO SLOT: the 3D bust goes between the greeting and the role in Phase 2 -->
    <section class="hero">
      <div class="hero-grid">
        <h1>Hi, I'm Batu.</h1>
        <p class="role">AI &amp; RevOps Architect.</p>
      </div>
      <span class="scroll-hint">Scroll</span>
    </section>

    <section class="about" id="about">
      <div class="about-stage">
        {paragraphs.map((html) => <p class="para" set:html={html} />)}
      </div>
    </section>

    <section class="projects" id="projects">
      <div class="wrap">
        <h2 class="section-title">Selected work</h2>
        <div class="stage" id="stage">
          {projects.map((p) => (
            <article class="project">
              <div class="txt-l">
                <h3>{p.title}</h3>
                <p>{p.left}</p>
              </div>
              <figure class="polaroid" style={`--rot:${p.rot}deg`}>
                <img src={`/projects/${p.slug}.svg`} alt={`${p.title} screenshot`} loading="lazy" />
                <figcaption>{p.title}</figcaption>
              </figure>
              <div class="txt-r">
                <p>{p.right}</p>
                <div class="stack">{p.stack.map((t) => <span>{t}</span>)}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="wrap">
        <div class="contact-grid">
          <div class="contact-img"><img src="/profile.jpeg" alt="Batuhan Öztürk surfing in a suit" loading="lazy" /></div>
          <div>
            <h2 class="section-title">Let's talk.</h2>
            <a class="mail" href="mailto:ozturkbatu@gmail.com">ozturkbatu@gmail.com</a>
            <div class="links">
              <a href="https://www.linkedin.com/in/ozturkbatu/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
              <a href="https://x.com/ozturkbatu_" target="_blank" rel="noopener noreferrer">X ↗</a>
              <a href="https://github.com/ozturkbatu" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </div>
            <a class="cv-btn" href="/cv.pdf" download>Download CV ↓</a>
            <GithubContributions />
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <img class="big-sig" src="/signature.png" alt="" loading="lazy" />
    <div class="legal">
      <a href="/impressum">Imprint</a>
      <a href="/datenschutz">Privacy</a>
      <span>&copy; {new Date().getFullYear()}</span>
    </div>
  </footer>

  <script>
    import '../scripts/story.js';
  </script>
</StoryLayout>
