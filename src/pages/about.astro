            <svg class="w-6 h-6" fill="black" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          
          <!-- Substack -->
          <a href="https://marketitive.substack.com/" class="inline-flex items-center justify-center w-12 h-12 bg-[#FF6719] hover:bg-[#E55A0F] text-white rounded-lg transition-colors" target="_blank" rel="noopener noreferrer" title="Substack">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
